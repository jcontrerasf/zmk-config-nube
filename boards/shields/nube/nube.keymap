// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100    // default: 10

#include <dt-bindings/zmk/pointing.h>

/ {
  behaviors {
    scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
      tap-ms = <20>;
    };

    scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
      tap-ms = <20>;
    };

  };
};

&soft_off {
    hold-time-ms = <3000>;
};

/ {
    macros {
        macro_ctrl_c: macro_ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp C>,
                       <&macro_release &kp LCTRL>;
        };

        macro_ctrl_x: macro_ctrl_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp X>,
                       <&macro_release &kp LCTRL>;
        };

        macro_ctrl_v: macro_ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp V>,
                       <&macro_release &kp LCTRL>;
        };

        macro_ctrl_shift_v: macro_ctrl_shift_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_press &kp LSHIFT>,
                       <&macro_tap &kp V>,
                       <&macro_release &kp LSHIFT>,
                       <&macro_release &kp LCTRL>;
        };
    };
};


/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            bindings = <
                &macro_ctrl_c    &macro_ctrl_x          &none    &kp U
                &macro_ctrl_v    &macro_ctrl_shift_v    &mo 1    &kp L
            >;
            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };

        bluetooth_layer {
            display-name = "Bluetooth";

            bindings = <
                &bt BT_CLR    &bt BT_SEL 0    &bt BT_SEL 1    &trans
                &soft_off     &trans          &trans          &studio_unlock
            >;
            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
